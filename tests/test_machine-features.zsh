#!/usr/bin/env zsh
# Tests for the `.feature` machine capability flags
# (asked for by .chezmoi.toml.tmpl during `chezmoi init`, consumed by templates).
#
# A feature is a yes/no choice stored under [data.feature] in the machine's own
# chezmoi config. Templates are rendered through a throwaway chezmoi config that
# carries those choices, which lets any machine be simulated from here.
emulate -L zsh

REPO=${1:-${0:A:h:h}}

typeset -i pass=0 fail=0
assert_eq() {
  local desc=$1 got=$2 want=$3
  if [[ $got == $want ]]; then print -r -- "  ok: $desc"; (( pass++ ))
  else print -r -- "FAIL: $desc"; print -r -- "      want: [$want]"; print -r -- "      got:  [$got]"; (( fail++ )); fi
}

work=$(mktemp -d)
trap "rm -rf $work" EXIT

# Every feature and the question `chezmoi init` asks for it.
FEATURES=( essentials nice_to_have dev )
typeset -A QUESTION=(
  essentials    "  Do you want essential tools"
  nice_to_have  "  Do you want nice to have tools"
  dev           "  Do you want developer tools"
)

# init_with <feature=bool ...> -> the chezmoi config generated by those
# answers. The heading goes to stdout too, so the config is everything from the
# first TOML comment on.
init_with() {
  local answer answers=()
  for answer in "$@"; do
    answers+=( "$QUESTION[${answer%%=*}]=${answer#*=}" )
  done
  chezmoi --source $REPO execute-template --init --promptBool ${(j:,:)answers} \
    < $REPO/.chezmoi.toml.tmpl | sed -n '/^# Personal data/,$p'
}
# toml_get <toml> <dotted key> -> the value, booleans lower-cased
toml_get() {
  python3 -c '
import sys, tomllib
v = tomllib.loads(sys.argv[1])
for k in sys.argv[2].split("."): v = v[k]
print(str(v).lower())' "$1" $2
}

print -r -- "== chezmoi init turns the answers into [data.feature] =="
# One yes at a time, so an answer wired to the wrong key cannot hide.
for answered in $FEATURES; do
  answers=()
  for feature in $FEATURES; do
    [[ $feature == $answered ]] && answers+=( $feature=true ) || answers+=( $feature=false )
  done
  generated=$(init_with $answers)
  for feature in $FEATURES; do
    if [[ $feature == $answered ]]; then
      assert_eq "$answered answer lands in feature.$feature" "$(toml_get "$generated" data.feature.$feature)" "true"
    else
      assert_eq "$answered answer leaves $feature alone" "$(toml_get "$generated" data.feature.$feature)" "false"
    fi
  done
done

print -r -- "== defaults: essentials yes, everything else no =="
# Rendered without a config, so no earlier answers exist to fall back on, and
# without simulated answers, so every question takes its default — as an
# unattended `chezmoi init --promptDefaults` would.
generated=$(chezmoi --config $work/no-config.toml --source $REPO execute-template --init \
  < $REPO/.chezmoi.toml.tmpl | sed -n '/^# Personal data/,$p')
assert_eq "essentials defaults to yes"   "$(toml_get "$generated" data.feature.essentials)"   "true"
assert_eq "nice_to_have defaults to no"  "$(toml_get "$generated" data.feature.nice_to_have)" "false"
assert_eq "dev defaults to no"           "$(toml_get "$generated" data.feature.dev)"          "false"

print -r -- "== macos follows the operating system =="
assert_eq "macos matches this host" "$(toml_get "$generated" data.feature.macos)" \
  "$([[ $OSTYPE == darwin* ]] && print true || print false)"

print -r -- "== the machine data is under .me =="
assert_eq "me.machine.name is set" "$(( ${#$(toml_get "$generated" data.me.machine.name)} > 0 ))" "1"
assert_eq "me.machine.type is set" "$(( ${#$(toml_get "$generated" data.me.machine.type)} > 0 ))" "1"

print -r -- "== the ignore rules know the new data layout =="
cfg=$work/cfg.toml
printf '[data.chezmoi]\nos = "darwin"\n\n[data.me.machine]\nname = "work-laptop"\ntype = "laptop"\n\n[data.feature]\nessentials = true\nnice_to_have = false\ndev = false\nmacos = true\n' > $cfg
assert_eq ".chezmoiignore renders with .me.machine" \
  "$(chezmoi --config $cfg --source $REPO ignored >/dev/null 2>&1 && print ok || print broken)" "ok"
assert_eq "the repo's own mise tasks are not installed" \
  "$(chezmoi --config $cfg --source $REPO ignored | grep -cx mise.toml)" "1"
assert_eq "the tests are not installed" \
  "$(chezmoi --config $cfg --source $REPO ignored | grep -cx tests)" "1"

print -r -- "----"
print -r -- "pass=$pass fail=$fail"
(( fail == 0 ))
