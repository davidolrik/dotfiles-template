{{- /* code: language=zsh */ -}}
#!/bin/zsh

# Always use ~/.local/bin/mise (installed by run_once_00_install-mise.sh),
# ignoring any other mise in PATH (e.g. from Homebrew) for determinism.
if [[ ! -x {{ .chezmoi.homeDir }}/.local/bin/mise ]]; then
    echo "mise not found, skipping"
    exit 0
fi

eval "$({{ .chezmoi.homeDir }}/.local/bin/mise activate zsh)"

# Stale registry metadata would make mise resolve against what it last saw
echo "$ mise cache clear"
{{ .chezmoi.homeDir }}/.local/bin/mise cache clear

# Installs the versions pinned by ~/.config/mise/mise.lock. Upgrading is a
# deliberate step: `mise run chezmoi:mise:bump` in the source directory.
echo "$ mise install"
{{ .chezmoi.homeDir }}/.local/bin/mise --cd {{ .chezmoi.homeDir }} install
